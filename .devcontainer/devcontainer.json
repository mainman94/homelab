{
  "name": "homelab",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    // terraform, tflint, python, pre-commit, actionlint, shellcheck and
    // trivy are not features any more: mise.toml pins them and post-create
    // runs `mise install`. One version list, shared with CI — both used to
    // ask for `latest` independently.
    // Ansible for `make ansible-check` / `ansible-run`. The pre-commit
    // ansible-lint hook brings its own ansible-core, so linting works without
    // this — running the playbook against the router does not.
    "ghcr.io/devcontainers-extra/features/ansible:2": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "hashicorp.terraform",
        "redhat.ansible",
        "redhat.vscode-yaml",
        "timonwong.shellcheck"
      ],
      "settings": {
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true,
        "files.eol": "\n",
        // yamlfmt owns YAML formatting outside ansible/.
        "yaml.format.enable": false
      }
    }
  }
}
