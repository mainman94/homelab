{
  "name": "homelab",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "none",
      "tflint": "latest",
      "terragrunt": "none",
      "installTFsec": false,
      "installTerraformDocs": false
    },
    "ghcr.io/devcontainers-extra/features/opentofu:1": {
      "version": "latest"
    },
    // Ansible for `make ansible-check` / `ansible-run`. The pre-commit
    // ansible-lint hook brings its own ansible-core, so linting works without
    // this — running the playbook against the router does not.
    "ghcr.io/devcontainers-extra/features/ansible:2": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12",
      "installTools": false
    },
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "hashicorp.terraform",
        "redhat.ansible",
        "redhat.vscode-yaml",
        "timonwong.shellcheck"
      ],
      "settings": {
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true,
        "files.eol": "\n",
        // yamlfmt owns YAML formatting outside ansible/.
        "yaml.format.enable": false
      }
    }
  }
}
